# ============================================================
# Project assets: do not ignore them
# ============================================================
# Keep all trained models and checkpoints.
!models/
!models/**

# Keep all evaluation results, logs, graphs and visualizations.
!outputs/
!outputs/**

# Keep captured photographs, masks, and original metadata.
!captured/
!captured/**

# Keep final report and figures.
!reports/
!reports/**

# Keep source code, tests, and project scripts tracked.
!src/
!src/**
!scripts/
!scripts/**
!tests/
!tests/**

